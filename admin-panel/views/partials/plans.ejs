<section id="sec-plans" class="section">
  <h2>Plans & Billing</h2>

  <div class="card">
    <div class="flex-between">
      <h3>Plans</h3>
      <button class="btn btn-primary" onclick="showPlanForm()">+ Create Plan</button>
    </div>

    <div id="plan-form" class="hidden mt-10 form-bordered">
      <div class="form-grid">
        <input type="hidden" id="plan-id">
        <div class="form-group"><label>Name</label><input type="text" id="plan-name" class="input" required></div>
        <div class="form-group"><label>Price (INR)</label><input type="number" id="plan-price" class="input" value="0"></div>
        <div class="form-group"><label>Challenges/Day</label><input type="number" id="plan-challenges" class="input" value="1"></div>
        <div class="form-group"><label>Billing Cycle</label><select id="plan-cycle" class="input"><option value="monthly">Monthly</option><option value="yearly">Yearly</option></select></div>
      </div>
      <div class="form-row mt-10">
        <label><input type="checkbox" id="plan-analytics"> Analytics</label>
        <label><input type="checkbox" id="plan-modules"> Special Modules</label>
        <label><input type="checkbox" id="plan-kids"> Kids Mode</label>
        <label><input type="checkbox" id="plan-corporate"> Corporate Dashboard</label>
      </div>
      <div class="mt-10">
        <button class="btn btn-primary" onclick="savePlan()">Save Plan</button>
        <button class="btn btn-secondary" onclick="hide('plan-form')">Cancel</button>
      </div>
    </div>

    <table class="table mt-10">
      <thead><tr><th>Name</th><th>Price</th><th>Challenges/Day</th><th>Analytics</th><th>Modules</th><th>Kids</th><th>Active</th><th>Actions</th></tr></thead>
      <tbody id="plans-table"></tbody>
    </table>
  </div>

  <div class="card mt-20">
    <h3>Active Subscriptions</h3>
    <table class="table">
      <thead><tr><th>User</th><th>Plan</th><th>Started</th><th>Ends</th><th>Status</th></tr></thead>
      <tbody id="subscriptions-table"></tbody>
    </table>
  </div>
</section>
