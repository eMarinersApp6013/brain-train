<section id="sec-ai-settings" class="section">
  <h2>AI Settings</h2>

  <div class="card">
    <h3>Anthropic Claude</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>API Key</label>
        <input type="password" id="ai-claude-key" class="input" placeholder="sk-ant-...">
      </div>
      <div class="form-group">
        <label>Model</label>
        <select id="ai-claude-model" class="input">
          <option value="claude-sonnet-4-6">Claude Sonnet 4.6</option>
          <option value="claude-opus-4-6">Claude Opus 4.6</option>
        </select>
      </div>
    </div>
    <button class="btn btn-secondary mt-10" onclick="testAI('claude')">Test Connection</button>
    <span id="ai-claude-status" class="ml-10"></span>
    <p class="muted mt-10">Used for: Question generation, coach messages, hints, explanations</p>
  </div>

  <div class="card mt-20">
    <h3>OpenAI</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>API Key</label>
        <input type="password" id="ai-openai-key" class="input" placeholder="sk-...">
      </div>
      <div class="form-group">
        <label>Model</label>
        <select id="ai-openai-model" class="input">
          <option value="gpt-4o">GPT-4o</option>
          <option value="gpt-4o-mini">GPT-4o Mini</option>
        </select>
      </div>
    </div>
    <button class="btn btn-secondary mt-10" onclick="testAI('openai')">Test Connection</button>
    <span id="ai-openai-status" class="ml-10"></span>
    <p class="muted mt-10">Used for: Answer checking, brain age scoring, IQ estimation, fuzzy matching</p>
  </div>

  <div class="mt-20">
    <button class="btn btn-primary" onclick="saveAISettings()">Save AI Settings</button>
  </div>
</section>
