<section id="sec-flow" class="section">
  <h2>WhatsApp Flow Visualizer</h2>

  <div class="card">
    <div class="flex-between">
      <h3>Bot Conversation Flow</h3>
      <div>
        <select id="flow-view" class="input" onchange="renderFlow(this.value)">
          <option value="onboarding">Onboarding Flow</option>
          <option value="daily">Daily Session Flow</option>
          <option value="modules">Modules Flow</option>
          <option value="evening">Evening Flow</option>
          <option value="commands">Commands Overview</option>
        </select>
      </div>
    </div>

    <div id="flow-container" class="flow-container mt-20">
      <!-- Flow renders here -->
    </div>
  </div>

  <style>
    .flow-container { padding: 20px; overflow-x: auto; }
    .flow-node { background: #fff; border: 2px solid #6c5ce7; border-radius: 12px; padding: 14px 18px; margin: 8px 0; max-width: 500px; position: relative; }
    .flow-node.bot { border-color: #6c5ce7; background: #f8f7ff; }
    .flow-node.user { border-color: #00b894; background: #f0fff4; margin-left: 40px; }
    .flow-node.decision { border-color: #fdcb6e; background: #fffde7; border-style: dashed; }
    .flow-node.action { border-color: #e17055; background: #fff5f5; }
    .flow-node .node-label { font-size: 10px; text-transform: uppercase; font-weight: 700; color: #636e72; margin-bottom: 4px; }
    .flow-node .node-text { font-size: 14px; }
    .flow-arrow { text-align: center; color: #b2bec3; font-size: 20px; margin: 2px 0; }
    .flow-branch { display: flex; gap: 20px; margin: 10px 0; }
    .flow-branch > div { flex: 1; border-left: 3px solid #dfe6e9; padding-left: 15px; }
    .flow-branch-label { font-weight: 700; color: #6c5ce7; font-size: 12px; margin-bottom: 8px; }
    .flow-group { border: 1px solid #dfe6e9; border-radius: 12px; padding: 16px; margin: 16px 0; background: #fafafa; }
    .flow-group-title { font-weight: 700; font-size: 16px; color: #2d3436; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #6c5ce7; }
  </style>
</section>
