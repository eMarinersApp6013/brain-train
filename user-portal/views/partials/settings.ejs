<section id="tab-settings" class="tab-section">
  <h2>Settings</h2>
  <div class="card">
    <div class="form-group">
      <label>Daily Challenge Time</label>
      <select id="pref-timeslot" class="input">
        <option value="08:00">Morning (8:00 AM)</option>
        <option value="13:00">Afternoon (1:00 PM)</option>
        <option value="19:00">Evening (7:00 PM)</option>
      </select>
    </div>
    <div class="form-group">
      <label>Difficulty Level</label>
      <select id="pref-difficulty" class="input">
        <option value="easy">Easy</option>
        <option value="medium">Medium</option>
        <option value="hard">Hard</option>
      </select>
    </div>
    <button class="btn btn-primary mt-10" onclick="savePrefs()">Save Changes</button>
  </div>
</section>
